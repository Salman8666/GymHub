generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  passwordHash   String?
  role           String          @default("USER") // "USER" | "TRAINER"
  avatar         String?
  membershipType String?         @default("Member")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  trainerProfile TrainerProfile?
  bookings       Booking[]
  cart           Cart?
  orders         Order[]
  reviews        Review[]
}

model TrainerProfile {
  id                  String                 @id @default(uuid())
  userId              String                 @unique
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  bio                 String
  location            String
  specialties         String                 @default("[]") // JSON string array
  experienceYears     Int                    @default(0)
  hourlyRate          Float                  @default(0.0)
  verified            Boolean                @default(false)
  whatsapp            String?
  profileCompleteness Int                    @default(0)
  rankingScore        Float                  @default(0.0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  certifications      TrainerCertification[]
  gyms                Gym[]
  fitnessPlans        FitnessPlan[]
  availabilities      Availability[]
  bookings            Booking[]
  store               Store?
  storeOrders         StoreOrder[]
  reviews             Review[]
}

model TrainerCertification {
  id               String         @id @default(uuid())
  trainerProfileId String
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  name             String
  issuingBody      String
  year             Int
  createdAt        DateTime       @default(now())
}

model Gym {
  id                 String     @id @default(uuid())
  trainerProfileId   String
  trainerProfile     TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  name               String
  tagline            String
  rating             Float      @default(5.0)
  reviewsCount       Int        @default(0)
  location           String
  address            String
  dayPassPrice       Float
  monthlyPrice       Float
  image              String
  hours              String
  featured           Boolean    @default(false)
  acType             String     @default("AC") // "AC" | "Non-AC"
  admissionFee       Float      @default(0.0)
  googleMapsLocation String?
  whatsapp           String?
  placeId            String?
  lat                Float?
  lng                Float?
  isPublished        Boolean    @default(true)
  rankingScore       Float      @default(0.0)
  amenities          String     @default("[]")
  equipment          String     @default("[]")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  images             GymImage[]
  reviews            Review[]
}

model GymImage {
  id         String   @id @default(uuid())
  gymId      String
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  url        String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
}

model FitnessPlan {
  id            String                @id @default(uuid())
  trainerProfileId String
  trainerProfile TrainerProfile       @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  title         String
  category      String                // "Hypertrophy" | "Strength" | "Fat Loss" | "Calisthenics"
  durationWeeks Int                   @default(4)
  daysPerWeek   Int                   @default(5)
  difficulty    String                @default("Intermediate")
  price         Float
  rating        Float                 @default(5.0)
  enrolledCount Int                   @default(0)
  image         String
  description   String
  isPublished   Boolean               @default(true)
  rankingScore  Float                 @default(0.0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  schedules     FitnessPlanSchedule[]
}

model FitnessPlanSchedule {
  id            String      @id @default(uuid())
  fitnessPlanId String
  fitnessPlan   FitnessPlan @relation(fields: [fitnessPlanId], references: [id], onDelete: Cascade)
  dayOfWeek     String      // "Monday" .. "Sunday"
  activity      String
}

model Availability {
  id                 String         @id @default(uuid())
  trainerProfileId   String
  trainerProfile     TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  dayOfWeek          String         // "Monday" .. "Sunday"
  startTime          String         // "09:00"
  endTime            String         // "17:00"
  slotDurationMinutes Int           @default(60)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Booking {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainerProfileId String
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  gymId            String?
  date             String         // YYYY-MM-DD
  startTime        String         // "10:00"
  endTime          String         // "11:00"
  status           String         @default("CONFIRMED") // "PENDING" | "CONFIRMED" | "COMPLETED" | "CANCELLED"
  price            Float
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([trainerProfileId, date, startTime])
}

model Store {
  id                 String         @id @default(uuid())
  trainerProfileId   String         @unique
  trainerProfile     TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  name               String
  description        String
  logo               String?
  banner             String?
  contactInformation String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  products           Product[]
  storeOrders        StoreOrder[]
  discountCodes      DiscountCode[]
}

model Product {
  id           String           @id @default(uuid())
  storeId      String
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  description  String
  features     String           @default("[]") // JSON array of product feature strings
  category     String           // "Supplements" | "Apparel" | "Gear" | "Digital"
  price        Float
  stock        Int              @default(0)
  sku          String           @default("")
  image        String
  inStock      Boolean          @default(true)
  featured     Boolean          @default(false)
  isPublished  Boolean          @default(true)
  rankingScore Float            @default(0.0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  variants     ProductVariant[]
  images       ProductImage[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reviews      Review[]
}

model ProductVariant {
  id         String     @id @default(uuid())
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String     // "Medium / Gourmet Chocolate"
  attributes String     @default("{}") // JSON string of attributes
  price      Float
  stock      Int        @default(0)
  sku        String     @default("")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Order {
  id                   String       @id @default(uuid())
  parentOrderNumber    String       @unique
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount          Float
  discountAmount       Float        @default(0.0)
  status               String       @default("PAID") // "PENDING" | "PAID" | "CANCELLED"
  stripePaymentIntentId String?
  stripeSessionId      String?
  shippingAddress      String       @default("{}") // JSON string
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  storeOrders          StoreOrder[]
}

model StoreOrder {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  trainerProfileId String
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  subtotal         Float
  status           String         @default("PROCESSING") // "PROCESSING" | "SHIPPED" | "DELIVERED" | "CANCELLED"
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            OrderItem[]
}

model OrderItem {
  id           String          @id @default(uuid())
  storeOrderId String
  storeOrder   StoreOrder      @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name         String
  price        Float
  quantity     Int
  createdAt    DateTime        @default(now())
}

model Review {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymId            String?
  gym              Gym?            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainerProfileId String?
  trainerProfile   TrainerProfile? @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String
  verifiedPurchase Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model DiscountCode {
  id                 String   @id @default(uuid())
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code               String   @unique
  discountType       String   @default("PERCENTAGE") // "PERCENTAGE" | "FIXED"
  discountValue      Float
  minimumOrderAmount Float    @default(0.0)
  usageLimit         Int      @default(100)
  usageCount         Int      @default(0)
  active             Boolean  @default(true)
  expiryDate         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BlogPost {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  excerpt        String
  body           String
  heroImage      String
  category       String
  readTime       String
  authorName     String
  authorRole     String
  published      Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}
