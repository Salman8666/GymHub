# Copy this file to .env and replace the placeholders with real values.
# .env is gitignored and must never be committed.

# Database Connection (SQLite for easy zero-setup testing, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Auth & JWT Configuration
JWT_SECRET="change_me_to_a_random_string_min_32_chars"
AUTH_SECRET="change_me_to_a_random_string_min_32_chars"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Stripe Payments & Webhooks
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Object Storage (S3 Compatible)
S3_ENDPOINT="https://s3.amazonaws.com"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"
S3_BUCKET="your-s3-bucket"

# Email Services
EMAIL_API_KEY="your-resend-email-api-key"

# External APIs
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
